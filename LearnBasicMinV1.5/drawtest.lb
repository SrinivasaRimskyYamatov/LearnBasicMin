function main()
    var loop = 250
    var x = 0
    var y = 0
    var x2 = 500
    var y2 = 0
    var w = 0
    window.new(w,500,500)
    print w
    while(loop > 0)
        setcolor(w,200,0,0)
        draw.line(w,x,y,x2,y2)
        y = y + 1
        y2 = y2 + 1
        loop = loop - 1
    end
end
